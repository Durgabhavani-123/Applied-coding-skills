class Solution {
    public int[] sortedSquares(int[] nums) {
        int l=0,r=nums.length-1;
        int i=nums.length-1;
        int[] a=new int[nums.length];
        while(l<=r){
            if(Math.abs(nums[l])>Math.abs(nums[r])){
            a[i]=nums[l]*nums[l];
            l++;i--;
            }else{
                a[i]=nums[r]*nums[r];
                r--;i--;
            }
        }
    return a;
    }
        
    }
