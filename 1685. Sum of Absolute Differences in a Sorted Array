class Solution {
    public int[] getSumAbsoluteDifferences(int[] nums) {
        int leftsum=0,total=0,ls,rs;
        for(int i=0;i<nums.length;i++){
            total=total+nums[i];
        }
        int[] r=new int[nums.length];
        for(int i=0;i<nums.length;i++){
            ls=nums[i]*i-leftsum;
            rs=(total-leftsum-nums[i])-((nums.length-1-i)*nums[i]);
            r[i]=ls+rs;
            leftsum=leftsum+nums[i];


        }
        return r;
        
    }
}
